# Fiber Genius - plantilla productiva para Windows Server
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://fiber-genius.example

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fibergenius_bhp_prod
DB_USER=fibergenius_app
DB_PASSWORD=CHANGE_ME

DATA_ROOT=D:\COTENER\FiberGenius\data
MEDIA_ROOT=D:\COTENER\FiberGenius\media
LOG_ROOT=D:\COTENER\FiberGenius\logs
STATIC_ROOT=C:\ProgramData\COTENER\FiberGenius\static
BACKUP_ROOT=E:\COTENER\FiberGenius\backups
BACKUP_RETENTION_DAYS=30
FIBERGENIUS_IMPORT_RETENTION_DAYS=30
BACKUP_PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
BACKUP_PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe

FIBERGENIUS_LOGIN_MAX_ATTEMPTS=5
FIBERGENIUS_LOGIN_ATTEMPT_WINDOW_SECONDS=900
FIBERGENIUS_LOGIN_LOCKOUT_SECONDS=900
FIBERGENIUS_IDLE_TIMEOUT_SECONDS=1800

# Identidad y alcance: inventario, sin módulos operativos VeEX/OTDR.
FIBERGENIUS_VERSION=CHANGE_ME_RELEASE_VERSION
FIBERGENIUS_OPERATIONS_UI_ENABLED=False
VEEX_ENABLED=False
FIBERGENIUS_MAX_UPLOAD_BYTES=26214400
BACKUP_COMMAND_TIMEOUT_SECONDS=3600
# Las vistas comparten estas URLs. Sustituir por el proveedor aprobado por BHP.
FIBERGENIUS_MAP_TILE_LIGHT=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
FIBERGENIUS_MAP_TILE_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
